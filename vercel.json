{
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "build": {
    "env": {
      "PYTHON_VERSION": "3.13",
      "UV_PYTHON": "3.13"
    }
  },
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{web/**,node_modules/**,web/node_modules/**,web/dist/**,dist/**,api/dist/**,src/**,public/**,assets/**,tests/**,__tests__/**,docs/**,.git/**,.vercel/**,.venv/**,venv/**,**/__pycache__/**,**/*.pyc,**/*.ipynb,**/*.csv,**/*.parquet,**/*.sqlite,**/*.db,**/*.png,**/*.jpg,**/*.jpeg,**/*.webp,**/*.gif,**/*.mp4,**/*.mov}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/main.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
