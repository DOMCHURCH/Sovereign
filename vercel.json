{
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "build": {
    "env": {
      "PYTHON_VERSION": "3.13",
      "UV_PYTHON": "3.13"
    }
  },
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{web/**,node_modules/**,.git/**,dist/**,**/__pycache__/**,**/*.pyc}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/main.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
